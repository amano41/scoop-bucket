{
    "homepage": "https://crftwr.github.io/keyhac/",
    "description": "Python-scriptable keyboard customization for Windows and macOS",
    "license": "MIT",
    "version": "2.5.0",
    "url": "https://github.com/crftwr/keyhac/releases/download/v2.5.0/Keyhac-2.5.0-win64.zip",
    "hash": "b430ac07d1b7451e114c6c9318aae8e8f3774650fb8bf08349b61ec726a3ccb2",
    "extract_dir": "Keyhac",
    "bin": "Keyhac.exe",
    "shortcuts": [
        [
            "Keyhac.exe",
            "Keyhac"
        ]
    ],
    "persist": [
        "config.py",
        "extensions",
        "clipboard.json",
        "settings.json"
    ],
    "pre_install": [
        "if (!(Test-Path \"$persist_dir\\config.py\")) {",
        "    Copy-Item -Path \"$dir\\app\\keyhac\\_config.py\" -Destination \"$dir\\config.py\"",
        "}",
        "if (!(Test-Path \"$persist_dir\\clipboard.json\")) {",
        "    New-Item -Path \"$dir\\clipboard.json\" -ItemType File | Out-Null",
        "}",
        "if (!(Test-Path \"$persist_dir\\settings.json\")) {",
        "    New-Item -Path \"$dir\\settings.json\" -ItemType File | Out-Null",
        "}"
    ],
    "checkver": {
        "github": "https://github.com/crftwr/keyhac"
    },
    "autoupdate": {
        "url": "https://github.com/crftwr/keyhac/releases/download/v$version/Keyhac-$version-win64.zip"
    }
}
