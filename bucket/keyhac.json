{
    "homepage": "https://crftwr.github.io/keyhac/",
    "description": "Python-scriptable keyboard customization for Windows and macOS",
    "license": "MIT",
    "version": "2.7.0",
    "url": "https://github.com/crftwr/keyhac/releases/download/v2.7.0/Keyhac-2.7.0-win64.zip",
    "hash": "0b93ba7b1b18affc63dbe33735a847460b7c9a4e8c1f81246c3d4bf395db86e8",
    "extract_dir": "Keyhac",
    "bin": "Keyhac.exe",
    "shortcuts": [
        [
            "Keyhac.exe",
            "Keyhac"
        ]
    ],
    "persist": [
        "config.py",
        "clipboard.json",
        "settings.json",
        "extensions"
    ],
    "pre_install": [
        "if (!(Test-Path \"$persist_dir\\config.py\")) {",
        "    Copy-Item -Path \"$dir\\app\\keyhac\\_config.py\" -Destination \"$dir\\config.py\"",
        "}",
        "if (!(Test-Path \"$persist_dir\\clipboard.json\")) {",
        "    Write-Output '{\"clipboard_history\": [{\"type\": \"string\", \"data\": \"\"}]}' | Out-File \"$dir\\clipboard.json\" -Encoding UTF8",
        "}",
        "if (!(Test-Path \"$persist_dir\\settings.json\")) {",
        "    Write-Output '{\"console_visible\": false}' | Out-File \"$dir\\settings.json\" -Encoding UTF8",
        "}"
    ],
    "checkver": {
        "github": "https://github.com/crftwr/keyhac"
    },
    "autoupdate": {
        "url": "https://github.com/crftwr/keyhac/releases/download/v$version/Keyhac-$version-win64.zip"
    }
}
